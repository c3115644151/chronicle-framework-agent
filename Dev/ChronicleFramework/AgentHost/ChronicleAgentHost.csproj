<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ChronicleAgentHost</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <RootNamespace>ChronicleFramework.AgentHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\AgentProviderConfigurationValidator.cs" Link="AgentProviderConfigurationValidator.cs" />
    <Compile Include="..\AgentHostReadyProtocol.cs" Link="AgentHostReadyProtocol.cs" />
  </ItemGroup>
</Project>
