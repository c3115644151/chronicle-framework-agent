<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ChronicleAgentHost</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <RootNamespace>ChronicleFramework.AgentHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="[2.0.1]" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\deepseek_v4_tokenizer.zip" LogicalName="ChronicleFramework.AgentHost.deepseek_v4_tokenizer.zip" />
    <EmbeddedResource Include="Resources\DeepSeekV4Tokenizer-LICENSE.txt" LogicalName="ChronicleFramework.AgentHost.deepseek_v4_tokenizer-license.txt" />
    <None Update="Resources\*.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\mod\AgentProviderConfigurationValidator.cs" Link="AgentProviderConfigurationValidator.cs" />
    <Compile Include="..\mod\AgentHostReadyProtocol.cs" Link="AgentHostReadyProtocol.cs" />
    <Compile Include="..\mod\StoryModeEstablishClanLifecycleStatus.cs" Link="StoryModeEstablishClanLifecycleStatus.cs" />
  </ItemGroup>
</Project>
